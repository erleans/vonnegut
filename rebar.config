%% -*- erlang -*-
{minimum_otp_vsn, "29.0"}.

%% Prometheus 4.x still uses the supported legacy catch syntax internally.
{overrides, [{add, prometheus, [{erl_opts, [nowarn_deprecated_catch]}]}]}.
{erl_opts,
 [debug_info,
  warn_untyped_records,
  warnings_as_errors,
  nowarn_export_all]}.

{xref_checks,[undefined_function_calls,undefined_functions,locals_not_used,
              deprecated_function_calls,
              deprecated_functions]}.
%% ignore these warnings because lz4 and snappyer are optional dependencies
{xref_ignores, [{lz4, unpack, 1},
                {snappyer, decompress, 1}]}.

%% Eqwalizer marker types are ordinary aliases for Dialyzer. Include their
%% defining module in the PLT even though it is intentionally not a runtime app.
{dialyzer, [{plt_extra_mods, [eqwalizer]}]}.

{deps, [{eqwalizer_support,
         {git_subdir, "https://github.com/WhatsApp/eqwalizer.git",
          {ref, "01f151ca206bb019db0999a2c9c8c8aaae79bbab"}, "eqwalizer_support"}},
        {erlware_commons, "1.9.1"},
        {acceptor_pool, "1.0.1"},
        {shackle, "0.8.0"},
        {partisan, {git, "https://github.com/lasp-lang/partisan.git",
                    {ref, "8e2a6508ed958fd1dd0b4926a35e6e96b441b17d"}}},
        {recon, "2.5.6"},
        {gproc, "1.3.0"},
        {backoff, "1.1.6"},

        %% metrics and health check deps
        {elli, "3.3.0"},
        {prometheus, "4.11.0"},
        {elli_prometheus, "0.1.1"}]}.

{relx, [{release, {vonnegut, "semver"},
         [vonnegut]},

        {dev_mode, true},
        {include_erts, false},

        {sys_config, "config/sys.config"},
        {vm_args, "config/vm.args"},

        {extended_start_script, true},

        {overlay, [{copy, "config/shared.config", "config/shared.config"}]}]}.

{project_plugins, [{rebar3_proper, "0.12.1"},
                   {covertool, "2.0.7"}]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_export_enabled, true}.

{covertool, [{coverdata_files, ["ct.coverdata"]}]}.

{profiles,
 [{test, [{deps, [{brod, "4.6.3"}, {meck, "1.2.0"}, {proper, "1.5.0"}]}]},
 {prod, [{relx, [{sys_config, "config/prod_sys.config"},
                 {vm_args, "config/prod_vm.args"},
                 {dev_mode, false},
                 {include_erts, true},
                 {include_src, false},
                 {debug_info, strip}
                ]}]}
 ]}.

{proper_opts, [{sys_config, "config/proper.config"}]}.
{ct_opts, [{sys_config, "config/test.config"},
           {ct_hooks, [cth_surefire]}]}.
{dist_node, [{name, 'testrunner@127.0.0.1'}]}.
